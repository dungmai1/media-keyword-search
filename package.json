{
  "name": "media-keyword-search",
  "productName": "Media Keyword Search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Search Pexels and Pixabay photos/videos from a list of keywords",
  "author": "Media Keyword Search",
  "main": "electron/main.js",
  "scripts": {
    "app": "electron .",
    "web": "node server.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.mediakeywordsearch.app",
    "productName": "Media Keyword Search",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  }
}
